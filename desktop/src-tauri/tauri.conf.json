{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ffxi-wrapper",
  "version": "1.1.1",
  "identifier": "app.ffxiwrapper.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ffxi-wrapper",
        "width": 1100,
        "height": 740,
        "minWidth": 820,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../compose.yaml": "stack/compose.yaml",
      "../../docker/": "stack/docker/",
      "../../overrides/settings/README.md": "stack/overrides/settings/README.md"
    },
    "category": "Game"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4MzI4NkFGNzZDRTc1NTIKUldSU2RjNTJyNFl5YUNYQ0pkL2VLNlNiQlVaMEhkMDBpTHE0cWlYaUpIY1FKQjNQdEc1QXhWVDcK",
      "endpoints": ["https://github.com/akreao/ffxi-wrapper/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
