# Copy this file to .env and change the passwords.

# Where the server keeps dbtool's state and navmeshes. Relative paths are
# from this folder. Any filesystem works.
DATA_DIR=./data

# Where the database lives. db-data is a Docker volume: it works
# everywhere, and on Windows it's the only reliable choice (Docker Desktop
# can move its disk to another drive). On Linux it can instead be a folder
# on a Linux filesystem (ext4, btrfs, xfs), such as ./data/db. Not exFAT or
# NTFS: MariaDB needs Linux file ownership and locking.
DB_DATA=db-data

# Database passwords. Any long random strings will do.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# The address the game client is sent for the map server. Keep 127.0.0.1
# when the client runs on this computer; use this computer's LAN (or VPN)
# address for players on other computers.
PUBLIC_IP=127.0.0.1

# Empty listens on every address of this computer. Set it to one of this
# computer's IPv4 addresses to keep the server off other networks.
# Docker's port rules go around ufw and firewalld, so this, not the host
# firewall, is what does that.
BIND_IP=

# The name shown in the client. Empty leaves it to overrides/settings/main.lua,
# or LSB's default.
SERVER_NAME=

# The LandSandBoat source the server comes from. The stack pulls the image
# GitHub built for LSB_COMMIT (ghcr.io/akreao/ffxi-wrapper/lsb:<commit>) and
# compiles it here only if there isn't one. This is also the pin GitHub
# builds from: change it here and in compose.yaml together.
LSB_REPO=https://github.com/akreao/lsb.git
LSB_COMMIT=6c02b556f1ce1a8d0acf38e14cb7be6ddadb9988

# Set to use another server image instead, for example
# ghcr.io/landsandboat/server:latest (upstream LandSandBoat, not the fork).
LSB_IMAGE=

# The game client, vana-client, is built from this fork at this commit. This
# repository's "Game client" workflow builds it and publishes it as the
# release client-<first 12 characters of the commit>, which the desktop app
# downloads. Change the commit to move players to another client build.
# The desktop app leaves CLIENT_COMMIT empty in the .env it writes, which
# means the commit pinned here on main (the app reads this file from GitHub
# once its build is published; offline, the one its own version came with).
# Set one there to hold a server folder to another published build.
CLIENT_REPO=https://github.com/akreao/vana-client
CLIENT_COMMIT=8c75a48f606b472265686e2e887c5356ac5bec8d
