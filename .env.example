# Copy this file to .env and change the passwords.

# Where the server keeps dbtool's state and navmeshes. Relative paths are
# from this folder. Any filesystem works.
DATA_DIR=./data

# Where the database lives. db-data is a Docker volume: it works
# everywhere, and on Windows it's the only reliable choice (Docker Desktop
# can move its disk to another drive). On Linux it can instead be a folder
# on a Linux filesystem (ext4, btrfs, xfs), such as ./data/db. Not exFAT or
# NTFS: MariaDB needs Linux file ownership and locking.
DB_DATA=db-data

# Database passwords. Any long random strings will do.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# The website's own database user (xiweb) gets this password; it can read what the
# pages show and change passwords, nothing else. Needed only with the web profile.
WEB_DB_PASSWORD=change-me-web

# The address the game client is sent for the map server. Keep 127.0.0.1
# when the client runs on this computer; use this computer's LAN (or VPN)
# address for players on other computers.
PUBLIC_IP=127.0.0.1

# Empty listens on every address of this computer. Set it to one of this
# computer's IPv4 addresses to keep the server off other networks.
# Docker's port rules go around ufw and firewalld, so this, not the host
# firewall, is what does that.
BIND_IP=

# The name shown in the client. Empty leaves it to overrides/settings/main.lua,
# or LSB's default.
SERVER_NAME=

# The LandSandBoat source the server comes from. The stack pulls the image
# GitHub built for LSB_COMMIT (ghcr.io/akreao/ffxi-wrapper/lsb:<commit>) and
# compiles it here only if there isn't one. This is also the pin GitHub
# builds from: change it here and in compose.yaml together.
LSB_REPO=https://github.com/akreao/lsb.git
LSB_COMMIT=c4c28a33ed9ab7a40479f7b81a4ec0e118ad8ccc

# Set to use another server image instead, for example
# ghcr.io/landsandboat/server:latest (upstream LandSandBoat, not the fork).
LSB_IMAGE=

# The game client, vana-client, is built from this fork at this commit. This
# repository's "Game client" workflow builds it and publishes it as the
# release client-<first 12 characters of the commit>, which the desktop app
# downloads. Change the commit to move players to another client build.
# The desktop app leaves CLIENT_COMMIT empty in the .env it writes, which
# means the commit pinned here on main (the app reads this file from GitHub
# once its build is published; offline, the one its own version came with).
# Set one there to hold a server folder to another published build.
CLIENT_REPO=https://github.com/akreao/vana-client
CLIENT_COMMIT=d63a00063a2bf8cc33de2966267b1a62f33c142a

# The auction house bot, ffxiahbot (https://github.com/AdamGagorik/ffxiahbot).
# COMPOSE_PROFILES=ahbot turns it on; empty leaves it off. It buys what
# players put up for sale and keeps the auction house stocked from a price
# list taken from retail.
COMPOSE_PROFILES=
# The seller and buyer name shown at the auction house (up to 15 characters).
AHBOT_NAME=M.H.M.U.
# Seconds between looking for player listings to buy, and between restocks.
AHBOT_TICK=30
AHBOT_RESTOCK=3600
# yes or no: buy players' listings, and sell (stock) items.
AHBOT_BUY=yes
AHBOT_SELL=yes
# The price list: items75 (items from the level 75 era), items (every item),
# or custom (DATA_DIR/ahbot/items.csv, made from items75 on first use).
AHBOT_ITEMS=items75
# The bot is built from this commit; the repository's "Auction house bot
# image" workflow publishes it as ghcr.io/akreao/ffxi-wrapper/ahbot:<commit>.
# Change it here and in compose.yaml together. AHBOT_IMAGE runs another image.
AHBOT_REPO=https://github.com/AdamGagorik/ffxiahbot
AHBOT_COMMIT=8a42d681e6c94437bade0d4d03d9a8ac9234db0f
AHBOT_IMAGE=

# The website (web/): a public home page, a My account page for every game
# account, and an admin panel for Moderator and Owner accounts (website roles,
# set by an owner on the site; GM levels are in-game only). Add web to
# COMPOSE_PROFILES (comma-separated with ahbot) to run it. It listens on this
# computer only (http://127.0.0.1:54080); WEB_BIND_IP opens it to a LAN or
# Tailscale address of this computer, WEB_PORT changes the port.
WEB_BIND_IP=
WEB_PORT=54080
# The site is also always on http://127.0.0.1:54081, this computer only, for the
# desktop app's owner link. Change it if another program uses that port; keep it
# different from WEB_PORT.
WEB_LOCAL_PORT=54081
# 64 hex characters that sign the owner's one-minute sign-in link (made by the
# desktop app, or by hand: openssl rand -hex 32). Empty turns owner links off;
# game-account sign-in still works.
ADMIN_SECRET=
# Run another image instead of the one published for this version.
WEB_IMAGE=

# The website on the internet (see docs/website.md, "Website on the internet").
# Add public to COMPOSE_PROFILES (with web) to run a Caddy proxy that answers on
# ports 80 and 443 and gets a Let's Encrypt certificate for WEB_DOMAIN. Before
# that: a DNS record for WEB_DOMAIN pointing at this computer's internet
# address, and the router forwarding TCP 80 and 443 to this computer.
WEB_DOMAIN=
# Leave empty: it is https:// plus WEB_DOMAIN. Turns on Secure cookies and HSTS, and makes the
# site refuse a password sent over plain HTTP from the internet.
WEB_PUBLIC_URL=
# Add ddns to COMPOSE_PROFILES to keep that DNS record on Cloudflare pointing at
# this computer when its address changes. The token needs only Zone > DNS >
# Edit on the domain's zone; keep it here and nowhere else.
CLOUDFLARE_API_TOKEN=
